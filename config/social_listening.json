  "focus": {
    "_notes": "Topics to watch. 'highlight: true' pins the topic to the top of the Social Pulse page and the routine searches for it explicitly. 'boost' multiplies the topic's weight in the focus ranking (1.0 = normal). Keywords are matched case-insensitively as whole words/phrases.",
    "topics": [
      {
        "label": "Norovirus & illness",
        "keywords": [
          "norovirus",
          "outbreak",
          "food poisoning",
          "sick on board",
          "quarantine"
        ],
        "boost": 1.5,
        "highlight": true
      },
      {
        "label": "Itinerary changes & weather",
        "keywords": [
          "itinerary change",
          "missed port",
          "skipped port",
          "cancelled port",
          "canceled port",
          "hurricane",
          "storm",
          "rerouted",
          "diverted"
        ],
        "boost": 1.3,
        "highlight": true
      },
      {
        "label": "Pricing, fees & value",
        "keywords": [
          "gratuities",
          "gratuity",
          "service charge",
          "price increase",
          "fees",
          "drink package",
          "upcharge",
          "overpriced",
          "worth it",
          "value"
        ],
        "boost": 1.2,
        "highlight": false
      },
      {
        "label": "Food & dining",
        "keywords": [
          "buffet",
          "dining",
          "food was",
          "restaurant",
          "specialty dining",
          "main dining room"
        ],
        "boost": 1.0,
        "highlight": false
      },
      {
        "label": "Service & crew",
        "keywords": [
          "crew",
          "staff",
          "service was",
          "room steward",
          "cabin steward",
          "guest services"
        ],
        "boost": 1.0,
        "highlight": false
      },
      {
        "label": "Cabins & ship condition",
        "keywords": [
          "cabin",
          "stateroom",
          "balcony",
          "dirty",
          "mold",
          "plumbing",
          "no hot water",
          "dry dock",
          "drydock",
          "refurb"
        ],
        "boost": 1.0,
        "highlight": false
      },
      {
        "label": "Booking & customer service",
        "keywords": [
          "refund",
          "customer service",
          "on hold",
          "cancelled my",
          "canceled my",
          "rebooked",
          "future cruise credit"
        ],
        "boost": 1.2,
        "highlight": false
      },
      {
        "label": "Loyalty & perks",
        "keywords": [
          "Captain's Circle",
          "VIFP",
          "Crown & Anchor",
          "Crown and Anchor",
          "Latitudes",
          "Mariner Society",
          "loyalty",
          "elite status"
        ],
        "boost": 0.9,
        "highlight": false
      },
      {
        "label": "New ships & launches",
        "keywords": [
          "maiden voyage",
          "inaugural",
          "naming ceremony",
          "new ship",
          "sea trials",
          "delivery"
        ],
        "boost": 1.0,
        "highlight": false
      },
      {
        "label": "Safety & incidents",
        "keywords": [
          "man overboard",
          "medical evacuation",
          "medevac",
          "fire",
          "coast guard",
          "rescue",
          "collision",
          "ran aground",
          "evacuated"
        ],
        "boost": 1.5,
        "highlight": true
      }
    ]
  },
  "muted_keywords": [
    "hiring",
    "job opening",
    "apply now",
    "giveaway",
    "sweepstakes",
    "promo code",
    "affiliate",
    "casino app"
  ],
  "standouts": {
    "_notes": "A ship or destination 'stands out' when it has at least min_mentions posts in the window AND either its net score is at least min_abs_score away from zero or it has at least spike_mentions posts.",
    "min_mentions": 3,
    "min_abs_score": 25,
    "spike_mentions": 8,
    "max_listed": 8
  },
  "scoring": {
    "_notes": "Net sentiment = (positive - negative) / total * 100, from -100 to +100. 'weighted' applies the platform weights above. Neutral posts count toward volume only.",
    "sample_posts_per_brand": 3,
    "excerpt_chars": 160
  },
  "history_days": 30
}
