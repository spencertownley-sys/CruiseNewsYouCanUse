{
  "_readme": "Backend controls for the Social Pulse feature. Edit this file to change what the daily social listening run looks for, how posts are attributed, and what gets highlighted. scripts/social_listening.py reads it on every run; the daily routine reads the 'focus' and 'queries' sections to decide what to search for.",
  "version": 1,
  "window_hours": 24,
  "monday_window_hours": 72,
  "platforms": {
    "x": {
      "label": "X",
      "enabled": true,
      "weight": 1.0,
      "site": "x.com",
      "notes": "No public API. Gathered via web search (site:x.com / twitter.com) and fetched pages."
    },
    "threads": {
      "label": "Threads",
      "enabled": true,
      "weight": 1.0,
      "site": "threads.net",
      "notes": "No public API. Gathered via web search (site:threads.net / threads.com)."
    },
    "bluesky": {
      "label": "Bluesky",
      "enabled": true,
      "weight": 1.0,
      "site": "bsky.app",
      "notes": "Public search API (public.api.bsky.app) when the network allows; otherwise web search (site:bsky.app)."
    },
    "instagram": {
      "label": "Instagram",
      "enabled": true,
      "weight": 0.8,
      "site": "instagram.com",
      "notes": "No public API. Gathered via web search (site:instagram.com), captions and public comments only."
    },
    "facebook": {
      "label": "Facebook",
      "enabled": true,
      "weight": 0.8,
      "site": "facebook.com",
      "notes": "No public API. Public pages and groups via web search (site:facebook.com)."
    }
  },
  "queries": {
    "_notes": "Each template is run once per platform the routine searches, with {site} replaced by the platform's site. Add or remove templates to broaden or narrow the daily pull.",
    "templates": [
      "{site} \"Princess Cruises\"",
      "{site} \"Carnival\" cruise",
      "{site} \"Holland America\"",
      "{site} \"Seabourn\"",
      "{site} \"Royal Caribbean\"",
      "{site} \"Norwegian Cruise Line\" OR \"NCL\" cruise",
      "{site} \"Celebrity Cruises\"",
      "{site} \"MSC Cruises\"",
      "{site} \"Virgin Voyages\"",
      "{site} \"Disney Cruise\"",
      "{site} cruise ship complaint OR cancelled OR norovirus",
      "{site} cruise \"best cruise\" OR \"amazing cruise\" OR \"never again\""
    ],
    "max_posts_per_platform": 40
  },
